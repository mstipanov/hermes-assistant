    <string name="capture_desc">Automatski prekida snimanje nakon kratke stanke. Start–stop snima dok ponovno ne tapneš veliki gumb, pa snimku šalje na Hermes STT.</string>
    <string name="voice_section">Glas</string>
    <string name="continue_listening">Nastavi slušati nakon odgovora</string>
    <string name="continue_listening_desc">Nakon što Hermes završi odgovor, odmah ponovno otvori mikrofon za sljedeće pitanje.</string>
    <string name="voice_replies">Glasovni odgovori</string>
    <string name="voice_replies_desc">Hermes govori samo kad je pitanje bilo glasovno. Na tipkani tekst odgovara samo tekstom.</string>
    <string name="tts_voice">TTS glas</string>
    <string name="android_fast">Android (brzo)</string>
    <string name="hermes_gabrijela">Hermes Gabrijela</string>
    <string name="tts_desc">Android koristi glas koji telefon ima (Samsung je često potpuno lokalan, Google može koristiti mrežni glas) — počinje gotovo odmah. Hermes Gabrijela je kvalitetniji neuralni glas, ali prvi zvuk čeka server.</string>
    <string name="phone_voice">Glas telefona</string>
    <string name="no_voices">Još nema popisa glasova. Otvori postavke glasa telefona i instaliraj hrvatski glas, ili odaberi Hermes Gabrijelu.</string>
