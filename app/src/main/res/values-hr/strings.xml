    <string name="default_view">Zadani prikaz</string>
    <string name="audio_only">Audio only</string>
    <string name="chat">Razgovor</string>
    <string name="audio_only_desc">Audio only je veliki orb, status i zadnji odgovor — bez tipkovnice i transkripta. Idealno za auto i MyCar.</string>
    <string name="stt_section">Prepoznavanje govora (STT)</string>
    <string name="google_fast">Google (brzo)</string>
    <string name="hermes_server_private">Hermes server (privatno)</string>
    <string name="stt_desc">Google koristi isti recognition servis kao Gboard i mnogo je brži. Audio ide Googleu. Hermes server šalje snimku na tvoj Mac (Whisper medium) — privatnije, ali sporije.</string>
    <string name="open_speech_settings">Otvori postavke prepoznavanja govora</string>
    <string name="capture_section">Mikrofon</string>
    <string name="capture_auto">Automatski</string>
