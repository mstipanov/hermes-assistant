    <!-- Settings: views and voice -->
    <string name="default_view">Default view</string>
    <string name="audio_only">Audio only</string>
    <string name="chat">Chat</string>
    <string name="audio_only_desc">Audio only is a large orb, status, and the last answer — no keyboard or transcript. Ideal for the car and MyCar.</string>
