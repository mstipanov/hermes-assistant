    <string name="google_fast">Google (fast)</string>
    <string name="hermes_server_private">Hermes server (private)</string>
    <string name="stt_desc">Google uses the same recognition service as Gboard and is much faster. Audio goes to Google. Hermes server sends the recording to your Mac (Whisper medium) — more private, but slower.</string>
