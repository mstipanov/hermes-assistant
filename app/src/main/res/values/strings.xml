    <string name="voice_replies">Voice replies</string>
    <string name="voice_replies_desc">Hermes speaks only when the question was spoken. Typed text gets a text-only answer.</string>
    <string name="tts_voice">TTS voice</string>
    <string name="android_fast">Android (fast)</string>
    <string name="hermes_gabrijela">Hermes Gabrijela</string>
    <string name="tts_desc">Android uses the voice installed on the phone (Samsung is often fully local, Google may use a network voice) — it starts almost immediately. Hermes Gabrijela is a higher-quality neural voice, but the first sound waits for the server.</string>
